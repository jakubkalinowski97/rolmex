---
import { company } from "../lib/company";
---

<section class="relative bg-slate-900 text-white overflow-hidden">
  <!-- Right-side hero image with smooth gradient fade -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-[url('/images/hero.jpg')] bg-cover bg-center sm:bg-[position:right_center] [mask-image:linear-gradient(to_top,transparent_5%,rgba(0,0,0,0.4)_30%,rgba(0,0,0,0.6)_50%,rgba(0,0,0,0.3)_100%)] sm:[mask-image:linear-gradient(to_right,transparent_40%,rgba(0,0,0,0.33)_55%,rgba(0,0,0,0.66)_75%,black_100%)]"></div>
    <!-- Top/bottom vignette -->
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900/60 via-slate-900/30 to-slate-900/70 sm:from-slate-900/40 sm:via-transparent sm:to-slate-900/50"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 lg:py-28">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm text-sm font-medium px-4 py-2 rounded-full mb-8 border border-white/10">
        <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
        Wypożyczalnia czynna dzisiaj do {company.godziny.pn_pt.split(" - ")[1]}
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.1] tracking-tight">
        Wypożycz sprzęt ogrodowy
        <span class="block mt-2 bg-gradient-to-r from-amber-400 to-orange-400 bg-clip-text text-transparent">szybko i tanio</span>
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-xl leading-relaxed">
        Profesjonalny sprzęt ogrodowy do wynajęcia. Kosiarki, piły, glebogryzarki i wiele więcej — wszystko czego potrzebujesz do zadbania o swój ogród.
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/katalog"
          class="inline-flex items-center px-7 py-3.5 bg-primary text-white font-bold rounded-xl hover:bg-primary-dark transition-colors duration-200"
        >
          Zobacz katalog
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a
          href={company.telefonLink}
          class="inline-flex items-center px-7 py-3.5 bg-white/10 backdrop-blur-sm text-white font-bold rounded-xl hover:bg-white/20 transition-all border border-white/20"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          Zadzwoń do nas
        </a>
      </div>

      <!-- Trust indicators -->
      <div class="mt-12 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 sm:gap-6 text-sm text-slate-400">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          Odbiór tego samego dnia
        </div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          Serwisowany sprzęt
        </div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          Zapewniamy transport
        </div>
      </div>
    </div>
  </div>
</section>
