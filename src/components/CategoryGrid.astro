---
import { getCollection } from "astro:content";

const categories = (await getCollection("category"))
  .sort((a, b) => (a.data.kolejnosc ?? 99) - (b.data.kolejnosc ?? 99))
  .slice(0, 6);
---

<section class="py-16 lg:py-24 bg-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-primary font-semibold text-sm uppercase tracking-wider mb-3">Nasza oferta</p>
      <h2 class="text-3xl lg:text-4xl font-extrabold text-text">Kategorie sprzętu</h2>
      <p class="mt-4 text-text-light text-lg">Znajdź narzędzie idealne do Twojego zadania</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 lg:gap-5">
      {categories.map((cat) => (
        <a
          href={`/katalog/kategoria/${cat.data.slug}`}
          class="group block bg-white rounded-2xl border border-border hover:border-primary/30 hover:shadow-lg hover:shadow-primary/5 transition-all duration-200 overflow-hidden"
        >
          <div class="aspect-[4/3] bg-white overflow-hidden flex items-center justify-center p-4">
            {cat.data.zdjecie ? (
              <img
                src={cat.data.zdjecie}
                alt={cat.data.nazwa}
                class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-300"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-slate-100 rounded-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect></svg>
              </div>
            )}
          </div>
          <div class="p-4 text-center">
            <h3 class="font-semibold text-text group-hover:text-primary transition-colors">{cat.data.nazwa}</h3>
          </div>
        </a>
      ))}
    </div>

    <div class="text-center mt-10">
      <a
        href="/katalog"
        class="inline-flex items-center gap-2 text-primary font-semibold hover:text-primary/80 transition-colors text-lg"
      >
        Zobacz wszystkie kategorie
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>
