---
import Layout from "../layouts/Layout.astro";
import GoogleMap from "../components/GoogleMap.astro";
import { company } from "../lib/company";
---

<Layout title="Kontakt" description="Skontaktuj się z nami — adres, telefon, godziny otwarcia.">
  <!-- Page Header -->
  <section class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-primary font-semibold text-sm uppercase tracking-wider mb-3">Skontaktuj się z nami</p>
      <h1 class="text-3xl lg:text-5xl font-extrabold">Kontakt</h1>
      <p class="mt-4 text-slate-300 text-lg max-w-2xl mx-auto">Odwiedź nas, zadzwoń lub napisz — chętnie odpowiemy na Twoje pytania</p>
    </div>
  </section>

  <section class="py-12 lg:py-20 bg-bg">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Company Info -->
        <div class="space-y-6">
          <div class="bg-white rounded-2xl border border-border p-6 lg:p-8">
            <h2 class="font-bold text-xl mb-6 text-text">{company.nazwa}</h2>

            <div class="space-y-5">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                </div>
                <div>
                  <p class="font-semibold text-text">Adres</p>
                  <p class="text-text-light mt-0.5">{company.adres.ulica}</p>
                  <p class="text-text-light">{company.adres.kod} {company.adres.miasto}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                </div>
                <div>
                  <p class="font-semibold text-text">Telefon</p>
                  <a href={company.telefonLink} class="text-primary hover:underline mt-0.5 block">{company.telefon}</a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                </div>
                <div>
                  <p class="font-semibold text-text">Email</p>
                  <a href={`mailto:${company.email}`} class="text-primary hover:underline mt-0.5 block">{company.email}</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Hours Card -->
          <div class="bg-white rounded-2xl border border-border p-6 lg:p-8">
            <div class="flex items-start gap-4 mb-5">
              <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              </div>
              <p class="font-semibold text-text text-lg">Godziny otwarcia</p>
            </div>
            <div class="space-y-3 ml-14">
              <div class="flex justify-between items-center">
                <span class="text-text-light">Poniedziałek - Piątek</span>
                <span class="font-semibold text-text">{company.godziny.pn_pt}</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-text-light">Sobota</span>
                <span class="font-semibold text-text">{company.godziny.sobota}</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-text-light">Niedziela</span>
                <span class="font-semibold text-red-500">{company.godziny.niedziela}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Map -->
        <div class="bg-white rounded-2xl border border-border overflow-hidden h-full min-h-[400px]">
          <GoogleMap />
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 bg-gradient-to-r from-primary to-primary/90 rounded-2xl p-8 lg:p-10 text-center text-white">
        <h3 class="text-2xl font-bold mb-3">Potrzebujesz sprzętu na dziś?</h3>
        <p class="text-white/80 mb-6 max-w-xl mx-auto">Zadzwoń do nas, a przygotujemy sprzęt do odbioru. Obsługujemy klientów bez wcześniejszej rezerwacji!</p>
        <a
          href={company.telefonLink}
          class="inline-flex items-center gap-2 bg-white text-primary font-bold px-8 py-3.5 rounded-xl hover:bg-white/90 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          {company.telefon}
        </a>
      </div>
    </div>
  </section>
</Layout>
