---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = (await getCollection("blog"))
  .filter((p) => p.data.slug !== post.data.slug)
  .sort((a, b) => new Date(b.data.data).getTime() - new Date(a.data.data).getTime())
  .slice(0, 2);
---

<Layout title={post.data.tytul} description={`${post.data.tytul} — artykuł na blogu Rolmex.`}>
  <!-- Page Header -->
  <section class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white py-10 lg:py-14 pb-20 lg:pb-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-400 mb-4">
        <a href="/blog" class="hover:text-primary transition-colors">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-slate-300">{post.data.tytul}</span>
      </nav>
      <h1 class="text-3xl lg:text-4xl font-extrabold leading-tight">{post.data.tytul}</h1>
      <div class="mt-3 flex items-center gap-4 text-slate-400 text-sm">
        <time>
          {new Date(post.data.data).toLocaleDateString("pl-PL", { year: "numeric", month: "long", day: "numeric" })}
        </time>
        {post.data.autor && <span>| {post.data.autor}</span>}
      </div>
    </div>
  </section>

  <article class="py-10 lg:py-14 bg-bg">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      {post.data.zdjecie && (
        <div class="aspect-video rounded-2xl border border-border overflow-hidden -mt-20 lg:-mt-24 mb-6 relative z-10">
          <img src={post.data.zdjecie} alt={post.data.tytul} width="960" height="540" class="w-full h-full object-cover" />
        </div>
      )}

      {post.data.tagi && (
        <div class="mb-6 flex flex-wrap gap-2">
          {post.data.tagi.map((tag: string) => (
            <span class="text-xs bg-primary/10 text-primary px-3 py-1.5 rounded-full font-medium">{tag}</span>
          ))}
        </div>
      )}

      <div class="bg-white rounded-2xl border border-border p-8 lg:p-12">
        <div class="prose prose-gray prose-lg max-w-none prose-headings:text-text prose-headings:font-bold prose-a:text-primary prose-a:no-underline hover:prose-a:underline">
          <Content />
        </div>
      </div>

      <!-- Navigation -->
      <div class="mt-10 flex items-center justify-between">
        <a href="/blog" class="inline-flex items-center gap-2 text-primary font-semibold hover:text-primary/80 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
          Wszystkie artykuły
        </a>
      </div>

      <!-- Related Posts -->
      {allPosts.length > 0 && (
        <div class="mt-16 pt-12 border-t border-border">
          <h2 class="text-2xl font-bold text-text mb-6">Przeczytaj także</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {allPosts.map((p) => (
              <a
                href={`/blog/${p.data.slug}`}
                class="group bg-white rounded-2xl border border-border hover:border-primary transition-colors duration-200 overflow-hidden"
              >
                <div class="aspect-[16/9] bg-slate-50 overflow-hidden">
                  {p.data.zdjecie ? (
                    <img
                      src={p.data.zdjecie}
                      alt={p.data.tytul}
                      width="640"
                      height="360"
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-slate-300">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
                    </div>
                  )}
                </div>
                <div class="p-4">
                  <time class="text-sm text-text-light">
                    {new Date(p.data.data).toLocaleDateString("pl-PL", { year: "numeric", month: "long", day: "numeric" })}
                  </time>
                  <h3 class="mt-1 font-bold text-text group-hover:text-primary transition-colors">{p.data.tytul}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</Layout>
